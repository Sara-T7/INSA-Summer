# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# MySQL (XAMPP defaults shown - adjust if yours differ)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=identity_system

# Generate strong random secrets, e.g. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_ACCESS_SECRET=95c483c558ad6cbb6d54905475807fcbb18f889baa5db0fbc2ef5c7839c23c471c8aeaf436640795048f3adccc5d2cdcb746a8f09b23894e7d4cfa95840e6f9e
ACCESS_TOKEN_TTL=15m

# Refresh tokens are opaque random strings, not JWTs - stored hashed in DB
REFRESH_TOKEN_TTL_DAYS=7

# Google Sign-In: create an OAuth Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID= 145990513571-npe5593qi8up4t2mts2necgqbnqm7056.apps.googleusercontent.com

# Frontend origin allowed to call this API
CORS_ORIGIN=http://127.0.0.1:5500
# Set to true once you serve the site over HTTPS in production
COOKIE_SECURE=false
